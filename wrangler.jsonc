{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "almira-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "ENVIRONMENT": "local", "CHECKOUT_ENABLED": "false", "PANCAKE_READ_ENABLED": "false", "PANCAKE_WRITE_ENABLED": "false", "CATALOG_MAX_AGE_SECONDS": "3600" },
  "d1_databases": [{ "binding": "DB", "database_name": "almira-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["* * * * *"] },
  "env": {
    "production": {
      "name": "almira-production",
      "routes": [{ "pattern": "almirastudio.vn/*", "zone_id": "115c065287dc9207fb67a2a054bc536b" }],
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "production", "CHECKOUT_ENABLED": "false", "PANCAKE_READ_ENABLED": "true", "PANCAKE_WRITE_ENABLED": "false", "CATALOG_MAX_AGE_SECONDS": "3600", "PANCAKE_SHOP_ID": "1720091522" },
      "d1_databases": [{ "binding": "DB", "database_name": "almira-production", "database_id": "9893a104-a9a8-4451-a5ac-092d7ab70128", "migrations_dir": "migrations" }],
      "triggers": { "crons": ["* * * * *"] }
    },
    "staging": {
      "name": "almira-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "staging", "CHECKOUT_ENABLED": "false", "PANCAKE_READ_ENABLED": "false", "PANCAKE_WRITE_ENABLED": "false", "CATALOG_MAX_AGE_SECONDS": "3600" },
      "d1_databases": [{ "binding": "DB", "database_name": "almira-staging", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "migrations" }],
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
